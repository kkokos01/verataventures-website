{
  "format": "verata-design-tokens/1.0",
  "brand": {
    "name": "Verata Ventures",
    "system": "Live Mineral / Humanist Intelligence",
    "idea": "Judgment, accelerated.",
    "version": "1.1.0",
    "date": "2026-07-22"
  },
  "color": {
    "core": {
      "mist": "#F3F7F6",
      "paper": "#FCFEFD",
      "ink": "#071B18",
      "inkSoft": "#314A45",
      "steel": "#5B706B",
      "rule": "#C7D2CF",
      "mineral": "#00877E",
      "mineralText": "#007A73",
      "mineralDeep": "#006C65",
      "mineralBright": "#15B8AA",
      "citron": "#C7F23A",
      "coral": "#FF5A46",
      "current": "#03231F",
      "currentSurface": "#07342F",
      "currentRaised": "#0A4039",
      "pale": "#F4FAF8",
      "paleMuted": "#B5C8C4",
      "darkRule": "#35645D"
    },
    "light": {
      "background": "{color.core.mist}",
      "surface": "{color.core.paper}",
      "text": "{color.core.ink}",
      "textSecondary": "{color.core.inkSoft}",
      "textMuted": "{color.core.steel}",
      "border": "{color.core.rule}",
      "accent": "{color.core.mineralText}",
      "accentVisual": "{color.core.mineral}",
      "accentStrong": "{color.core.mineralDeep}",
      "signal": "{color.core.citron}",
      "decision": "{color.core.coral}"
    },
    "dark": {
      "background": "{color.core.current}",
      "surface": "{color.core.currentSurface}",
      "surfaceRaised": "{color.core.currentRaised}",
      "text": "{color.core.pale}",
      "textSecondary": "{color.core.paleMuted}",
      "border": "{color.core.darkRule}",
      "accent": "{color.core.mineralBright}",
      "signal": "{color.core.citron}",
      "decision": "{color.core.coral}"
    }
  },
  "typography": {
    "family": {
      "display": "Newsreader",
      "sans": "Instrument Sans",
      "mono": "Geist Mono"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "webScale": {
      "display": { "size": "clamp(3.5rem, 7vw, 6rem)", "lineHeight": 0.96, "tracking": "-0.045em" },
      "h1": { "size": "clamp(2.75rem, 5vw, 4.5rem)", "lineHeight": 1.0, "tracking": "-0.035em" },
      "h2": { "size": "clamp(2rem, 3.5vw, 3rem)", "lineHeight": 1.06, "tracking": "-0.025em" },
      "h3": { "size": "clamp(1.5rem, 2.4vw, 2rem)", "lineHeight": 1.14, "tracking": "-0.018em" },
      "lead": { "size": "1.25rem", "lineHeight": 1.5, "tracking": "-0.01em" },
      "body": { "size": "1rem", "lineHeight": 1.62, "tracking": "0" },
      "small": { "size": "0.875rem", "lineHeight": 1.5, "tracking": "0" },
      "label": { "size": "0.6875rem", "lineHeight": 1.4, "tracking": "0.09em" }
    }
  },
  "space": {
    "unit": "4px",
    "2xs": "2px",
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px",
    "4xl": "96px",
    "5xl": "128px"
  },
  "layout": {
    "contentMax": "1240px",
    "readingMax": "720px",
    "gridColumnsDesktop": 12,
    "gridColumnsTablet": 8,
    "gridColumnsMobile": 4,
    "gutterDesktop": "24px",
    "gutterMobile": "16px"
  },
  "shape": {
    "radius": {
      "none": "0",
      "control": "2px",
      "status": "999px"
    },
    "border": {
      "hairline": "1px",
      "emphasis": "2px"
    }
  },
  "motion": {
    "duration": {
      "micro": "100ms",
      "short": "160ms",
      "standard": "280ms",
      "reveal": "480ms"
    },
    "easing": {
      "enter": "cubic-bezier(0.22, 0.61, 0.36, 1)",
      "exit": "cubic-bezier(0.55, 0.06, 0.68, 0.19)",
      "move": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
  }
}
